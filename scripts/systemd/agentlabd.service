[Unit]
Description=AgentLab daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
# Group=agentlab - NOT allowed: a non-root primary group breaks Proxmox IPC
# (ipcc_send_rec: Unknown error -1 on every qm/pvesh call).
UMask=0007
ExecStart=/usr/local/bin/agentlabd --config /etc/agentlab/config.yaml
Restart=on-failure
RestartSec=2
RuntimeDirectory=agentlab
RuntimeDirectoryMode=0750
StateDirectory=agentlab
StateDirectoryMode=0750
LogsDirectory=agentlab
LogsDirectoryMode=0750
StandardOutput=append:/var/log/agentlab/agentlabd.log
StandardError=append:/var/log/agentlab/agentlabd.log
# NoNewPrivileges=true - Disabled for Proxmox IPC compatibility (qm clone requires it)
# PrivateTmp=true - Disabled for Proxmox IPC compatibility
ProtectSystem=strict
# /var/log/pve is required: qm/pct task wrappers write to /var/log/pve/tasks,
# and a read-only path there fails every qm call ("Read-only file system").
# /run (not just /run/agentlab) is required: Proxmox IPC sockets live in
# /run/pve and ProtectSystem=strict would otherwise mount them read-only,
# breaking pmxcfs with ipcc_send_rec: Unknown error -1.
# The secrets API writes encrypted bundles in this directory.
# Managed-template activation atomically replaces files in the profiles directory.
ReadWritePaths=/etc/agentlab/secrets /etc/agentlab/profiles /etc/pve /var/lib/vz /var/lib/agentlab /var/log/agentlab /var/log/pve /run
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETGID CAP_SETUID CAP_NET_ADMIN CAP_SYS_ADMIN

[Install]
WantedBy=multi-user.target
