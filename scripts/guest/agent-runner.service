[Unit]
Description=Agent Runner
After=network-online.target cloud-final.service agentlab-workspace-setup.service
Wants=network-online.target agentlab-workspace-setup.service

ConditionPathExists=/etc/agentlab/bootstrap.json

[Service]
Type=simple
User=agent
Group=agent
Environment=AGENTLAB_BOOTSTRAP=/run/agentlab-bootstrap/descriptor.json
Environment=AGENTLAB_SECRETS_DIR=/run/agentlab-bootstrap/secrets
Environment=AGENTLAB_CONTROLLER_CA=/run/agentlab-bootstrap/controller-ca.pem
EnvironmentFile=-/etc/agentlab/agent-runner.env
ExecStartPre=+/usr/local/bin/agent-bootstrap
ExecStart=/usr/local/bin/agent-runner
ExecStopPost=/usr/local/bin/agent-secrets-cleanup
ExecStopPost=+/usr/local/bin/agent-bootstrap --cleanup
Restart=on-failure
RestartSec=10
RuntimeDirectory=agentlab
RuntimeDirectoryMode=0700

[Install]
WantedBy=cloud-init.target
